<!-- @brand: Your Company | شركتك -->
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Tahoma, Arial, sans-serif" />
      <mj-text font-size="14px" color="{{foreground}}" line-height="1.6" />
    </mj-attributes>
    <mj-style>
      @media only screen and (max-width: 480px) {
        .stack-table td {
          display: block !important;
          width: 100% !important;
          box-sizing: border-box !important;
        }
        .stack-table tr {
          display: block !important;
          margin-bottom: 12px !important;
        }
        .stack-table-rtl td {
          text-align: right !important;
          direction: rtl !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="{{background}}" width="600px">

    <mj-include path="../../partials/header.mjml" />

    <!-- @ar -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px" direction="rtl">
      <mj-column>
        <mj-text align="center" padding-bottom="15px">
          <!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="{{primary}}" viewBox="0 0 256 256"><path d="M80,144v40a16,16,0,0,1-16,16H48a16,16,0,0,1-16-16V128H64A16,16,0,0,1,80,144Zm112-16a16,16,0,0,0-16,16v40a16,16,0,0,0,16,16h32V128Z" opacity="0.2"></path><path d="M201.89,54.66A104.08,104.08,0,0,0,24,128v56a24,24,0,0,0,24,24H64a24,24,0,0,0,24-24V144a24,24,0,0,0-24-24H40.36A88.12,88.12,0,0,1,190.54,65.93,87.39,87.39,0,0,1,215.65,120H192a24,24,0,0,0-24,24v40a24,24,0,0,0,24,24h24a24,24,0,0,1-24,24H136a8,8,0,0,0,0,16h56a40,40,0,0,0,40-40V128A103.41,103.41,0,0,0,201.89,54.66ZM64,136a8,8,0,0,1,8,8v40a8,8,0,0,1-8,8H48a8,8,0,0,1-8-8V136Zm128,56a8,8,0,0,1-8-8V144a8,8,0,0,1,8-8h24v56Z"></path></svg><!--<![endif]-->
        </mj-text>
        <mj-text font-size="22px" font-weight="bold" align="right" color="{{foreground}}" padding-bottom="5px">
          تم استلام طلبك
        </mj-text>
        <mj-text align="right" color="{{success}}" font-size="13px" font-weight="bold">
          سنتواصل معك في أقرب وقت
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Ticket details -->
    <mj-section background-color="{{card}}" padding="15px 25px" direction="rtl">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-text align="right" color="{{mutedForeground}}" font-size="12px" font-weight="bold" padding-bottom="10px">
          تفاصيل التذكرة
        </mj-text>
        <mj-table font-size="13px" color="{{foreground}}" cellpadding="5" css-class="stack-table stack-table-rtl">
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px; width: 120px;">رقم التذكرة</td>
            <td style="text-align: right; padding: 8px;">&#x200F;#SUP-2026-84512</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px;">الموضوع</td>
            <td style="text-align: right; padding: 8px;">مشكلة في تسجيل الدخول إلى الحساب</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px;">الأولوية</td>
            <td style="text-align: right; padding: 8px;">
              <span style="background-color: {{primary}}; color: {{primaryForeground}}; padding: 2px 10px; border-radius: 10px; font-size: 11px; font-weight: bold;">عادية</span>
            </td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px;">تاريخ الإرسال</td>
            <td style="text-align: right; padding: 8px;">&#x200F;19 مارس 2026، 3:45 م</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px;">وقت الرد المتوقع</td>
            <td style="text-align: right; padding: 8px;">&#x200F;خلال 24 ساعة</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="10px 25px 10px" direction="rtl">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" font-weight="bold" border-radius="8px" inner-padding="12px 30px" align="right" href="#">
          عرض التذكرة
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="0 25px 30px" direction="rtl">
      <mj-column>
        <mj-text align="right" color="{{mutedForeground}}" font-size="12px" font-style="italic">
          يمكنك الرد على هذا البريد الإلكتروني لإضافة تفاصيل إضافية إلى تذكرتك.
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- /@ar -->

    <!-- @en -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px">
      <mj-column>
        <mj-text align="center" padding-bottom="15px">
          <!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="{{primary}}" viewBox="0 0 256 256"><path d="M80,144v40a16,16,0,0,1-16,16H48a16,16,0,0,1-16-16V128H64A16,16,0,0,1,80,144Zm112-16a16,16,0,0,0-16,16v40a16,16,0,0,0,16,16h32V128Z" opacity="0.2"></path><path d="M201.89,54.66A104.08,104.08,0,0,0,24,128v56a24,24,0,0,0,24,24H64a24,24,0,0,0,24-24V144a24,24,0,0,0-24-24H40.36A88.12,88.12,0,0,1,190.54,65.93,87.39,87.39,0,0,1,215.65,120H192a24,24,0,0,0-24,24v40a24,24,0,0,0,24,24h24a24,24,0,0,1-24,24H136a8,8,0,0,0,0,16h56a40,40,0,0,0,40-40V128A103.41,103.41,0,0,0,201.89,54.66ZM64,136a8,8,0,0,1,8,8v40a8,8,0,0,1-8,8H48a8,8,0,0,1-8-8V136Zm128,56a8,8,0,0,1-8-8V144a8,8,0,0,1,8-8h24v56Z"></path></svg><!--<![endif]-->
        </mj-text>
        <mj-text font-size="22px" font-weight="bold" align="left" color="{{foreground}}" padding-bottom="5px">
          We Received Your Request
        </mj-text>
        <mj-text align="left" color="{{success}}" font-size="13px" font-weight="bold">
          We'll get back to you as soon as possible
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Ticket details -->
    <mj-section background-color="{{card}}" padding="15px 25px">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-text align="left" color="{{mutedForeground}}" font-size="12px" font-weight="bold" padding-bottom="10px">
          TICKET DETAILS
        </mj-text>
        <mj-table font-size="13px" color="{{foreground}}" cellpadding="5" css-class="stack-table">
          <tr>
            <td style="font-weight: bold; padding: 8px; width: 140px;">Ticket Number</td>
            <td style="padding: 8px;">#SUP-2026-84512</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px;">Subject</td>
            <td style="padding: 8px;">Account login issue</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px;">Priority</td>
            <td style="padding: 8px;">
              <span style="background-color: {{primary}}; color: {{primaryForeground}}; padding: 2px 10px; border-radius: 10px; font-size: 11px; font-weight: bold;">Normal</span>
            </td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px;">Submitted</td>
            <td style="padding: 8px;">March 19, 2026, 3:45 PM</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px;">Expected Response</td>
            <td style="padding: 8px;">Within 24 hours</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="10px 25px 10px">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" font-weight="bold" border-radius="8px" inner-padding="12px 30px" align="left" href="#">
          View Ticket
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="0 25px 30px">
      <mj-column>
        <mj-text align="left" color="{{mutedForeground}}" font-size="12px" font-style="italic">
          Reply to this email to add more details to your ticket.
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- /@en -->

    <mj-include path="../../partials/footer.mjml" />

  </mj-body>
</mjml>