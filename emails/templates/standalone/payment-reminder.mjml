<!-- @brand: Your Company | شركتك -->
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Tahoma, Arial, sans-serif" />
      <mj-text font-size="14px" color="{{foreground}}" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{background}}" width="600px">

    <mj-include path="../../partials/header.mjml" />

    <!-- @ar -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px" direction="rtl">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" align="right" color="{{foreground}}" padding-bottom="10px">
          تذكير بالدفع
        </mj-text>
        <mj-text align="right" color="{{mutedForeground}}">
          هذا تذكير بأن لديك دفعة مستحقة. يرجى إتمام الدفع لتجنب أي انقطاع في الخدمة.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px" direction="rtl">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-table font-size="14px" color="{{foreground}}" cellpadding="5">
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px;">رقم الفاتورة</td>
            <td style="text-align: left; padding: 8px;">#INV-2026-00891</td>
          </tr>
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px;">الاشتراك</td>
            <td style="text-align: left; padding: 8px;">الخطة المتقدمة — سنوي</td>
          </tr>
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px;">تاريخ الاستحقاق</td>
            <td style="text-align: left; padding: 8px; color: {{warning}}; font-weight: bold;">25 مارس 2026</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Amount -->
    <mj-section background-color="{{card}}" padding="10px 25px" direction="rtl">
      <mj-column>
        <mj-text align="center" color="{{mutedForeground}}" font-size="13px" padding-bottom="5px">
          المبلغ المستحق
        </mj-text>
        <mj-text align="center" color="{{primary}}" font-size="36px" font-weight="bold" padding-bottom="5px">
          2,400 د.إ
        </mj-text>
        <mj-text align="center" padding-bottom="5px">
          <span style="background-color: {{warning}}; color: #FFFFFF; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: bold;">
            مستحق خلال 7 أيام
          </span>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px 10px" direction="rtl">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="16px" font-weight="bold" border-radius="8px" inner-padding="14px 40px" align="center" href="#">
          ادفع الآن
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="5px 25px 30px" direction="rtl">
      <mj-column>
        <mj-text align="center" color="{{mutedForeground}}" font-size="12px">
          نقبل الدفع عبر: فيزا، ماستركارد، Apple Pay، تحويل بنكي
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- /@ar -->

    <!-- @en -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" align="left" color="{{foreground}}" padding-bottom="10px">
          Payment Reminder
        </mj-text>
        <mj-text align="left" color="{{mutedForeground}}">
          This is a reminder that you have a payment due. Please complete your payment to avoid any service interruption.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-table font-size="14px" color="{{foreground}}" cellpadding="5">
          <tr>
            <td style="font-weight: bold; padding: 8px;">Invoice</td>
            <td style="text-align: right; padding: 8px;">#INV-2026-00891</td>
          </tr>
          <tr>
            <td style="font-weight: bold; padding: 8px;">Subscription</td>
            <td style="text-align: right; padding: 8px;">Pro Plan — Annual</td>
          </tr>
          <tr>
            <td style="font-weight: bold; padding: 8px;">Due Date</td>
            <td style="text-align: right; padding: 8px; color: {{warning}}; font-weight: bold;">March 25, 2026</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Amount -->
    <mj-section background-color="{{card}}" padding="10px 25px">
      <mj-column>
        <mj-text align="center" color="{{mutedForeground}}" font-size="13px" padding-bottom="5px">
          Amount Due
        </mj-text>
        <mj-text align="center" color="{{primary}}" font-size="36px" font-weight="bold" padding-bottom="5px">
          AED 2,400
        </mj-text>
        <mj-text align="center" padding-bottom="5px">
          <span style="background-color: {{warning}}; color: #FFFFFF; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: bold;">
            Due in 7 days
          </span>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px 10px">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="16px" font-weight="bold" border-radius="8px" inner-padding="14px 40px" align="center" href="#">
          Pay Now
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="5px 25px 30px">
      <mj-column>
        <mj-text align="center" color="{{mutedForeground}}" font-size="12px">
          We accept: Visa, Mastercard, Apple Pay, Bank Transfer
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- /@en -->

    <mj-include path="../../partials/footer.mjml" />

  </mj-body>
</mjml>
