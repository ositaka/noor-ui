<!-- @brand: Your Company | شركتك -->
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Tahoma, Arial, sans-serif" />
      <mj-text font-size="14px" color="{{foreground}}" line-height="1.6" />
    </mj-attributes>
    <mj-style>
      @media only screen and (max-width: 480px) {
        .stack-table td {
          display: block !important;
          width: 100% !important;
          box-sizing: border-box !important;
        }
        .stack-table tr {
          display: block !important;
          margin-bottom: 12px !important;
        }
        .stack-table-rtl td {
          text-align: right !important;
          direction: rtl !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="{{background}}" width="600px">

    <mj-include path="../../partials/header.mjml" />

    <!-- @ar -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px" direction="rtl">
      <mj-column>
        <mj-text align="center" padding-bottom="15px">
          <!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="{{primary}}" viewBox="0 0 256 256"><g transform="translate(256,0) scale(-1,1)"><path d="M248,120v64a8,8,0,0,1-8,8H216a24,24,0,0,0-48,0H104a24,24,0,0,0-48,0H32a8,8,0,0,1-8-8V144H184V120Z" opacity="0.2"></path><path d="M255.42,117l-14-35A15.93,15.93,0,0,0,226.58,72H192V64a8,8,0,0,0-8-8H32A16,16,0,0,0,16,72V184a16,16,0,0,0,16,16H49a32,32,0,0,0,62,0h50a32,32,0,0,0,62,0h17a16,16,0,0,0,16-16V120A7.94,7.94,0,0,0,255.42,117ZM192,88h34.58l9.6,24H192ZM32,72H176v64H32ZM80,208a16,16,0,1,1,16-16A16,16,0,0,1,80,208Zm81-24H111a32,32,0,0,0-62,0H32V152H176v12.31A32.11,32.11,0,0,0,161,184Zm31,24a16,16,0,1,1,16-16A16,16,0,0,1,192,208Zm48-24H223a32.06,32.06,0,0,0-31-24V128h48Z"></path></g></svg><!--<![endif]-->
        </mj-text>
        <mj-text font-size="22px" font-weight="bold" align="right" color="{{foreground}}" padding-bottom="5px">
          طلبك في الطريق!
        </mj-text>
        <mj-text align="right" color="{{mutedForeground}}" font-size="13px">
          رقم الطلب: #ORD-2026-39174
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Status badge -->
    <mj-section background-color="{{card}}" padding="10px 25px" direction="rtl">
      <mj-column>
        <mj-text align="right" padding-bottom="5px">
          <span style="background-color: {{success}}; color: #FFFFFF; padding: 4px 14px; border-radius: 12px; font-size: 12px; font-weight: bold;">
            جاري التوصيل
          </span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Shipping details -->
    <mj-section background-color="{{card}}" padding="15px 25px" direction="rtl">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-text align="right" color="{{mutedForeground}}" font-size="12px" font-weight="bold" padding-bottom="10px">
          تفاصيل الشحن
        </mj-text>
        <mj-table font-size="13px" color="{{foreground}}" cellpadding="5" css-class="stack-table stack-table-rtl">
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px; width: 130px;">رقم التتبع</td>
            <td style="text-align: right; padding: 8px;">&#x200F;TRK-9847-2651-AE</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px;">التوصيل المتوقع</td>
            <td style="text-align: right; padding: 8px; color: {{success}}; font-weight: bold;">&#x200F;اليوم قبل الساعة 6:00 مساءً</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px;">عنوان التوصيل</td>
            <td style="text-align: right; padding: 8px;">شارع الشيخ زايد، برج •••، شقة ••••، دبي</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Note -->
    <mj-section background-color="{{card}}" padding="10px 25px" direction="rtl">
      <mj-column>
        <mj-text align="right" color="{{warning}}" font-size="13px" font-weight="bold" padding="12px 0">
          يجب تواجد شخص لاستلام الطلب.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px 30px" direction="rtl">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" font-weight="bold" border-radius="8px" inner-padding="12px 30px" align="right" href="#">
          تتبع الشحنة
        </mj-button>
      </mj-column>
    </mj-section>
    <!-- /@ar -->

    <!-- @en -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px">
      <mj-column>
        <mj-text align="center" padding-bottom="15px">
          <!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="{{primary}}" viewBox="0 0 256 256"><path d="M248,120v64a8,8,0,0,1-8,8H216a24,24,0,0,0-48,0H104a24,24,0,0,0-48,0H32a8,8,0,0,1-8-8V144H184V120Z" opacity="0.2"></path><path d="M255.42,117l-14-35A15.93,15.93,0,0,0,226.58,72H192V64a8,8,0,0,0-8-8H32A16,16,0,0,0,16,72V184a16,16,0,0,0,16,16H49a32,32,0,0,0,62,0h50a32,32,0,0,0,62,0h17a16,16,0,0,0,16-16V120A7.94,7.94,0,0,0,255.42,117ZM192,88h34.58l9.6,24H192ZM32,72H176v64H32ZM80,208a16,16,0,1,1,16-16A16,16,0,0,1,80,208Zm81-24H111a32,32,0,0,0-62,0H32V152H176v12.31A32.11,32.11,0,0,0,161,184Zm31,24a16,16,0,1,1,16-16A16,16,0,0,1,192,208Zm48-24H223a32.06,32.06,0,0,0-31-24V128h48Z"></path></svg><!--<![endif]-->
        </mj-text>
        <mj-text font-size="22px" font-weight="bold" align="left" color="{{foreground}}" padding-bottom="5px">
          Your Order is On Its Way!
        </mj-text>
        <mj-text align="left" color="{{mutedForeground}}" font-size="13px">
          Order Number: #ORD-2026-39174
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Status badge -->
    <mj-section background-color="{{card}}" padding="10px 25px">
      <mj-column>
        <mj-text align="left" padding-bottom="5px">
          <span style="background-color: {{success}}; color: #FFFFFF; padding: 4px 14px; border-radius: 12px; font-size: 12px; font-weight: bold;">
            Out for Delivery
          </span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Shipping details -->
    <mj-section background-color="{{card}}" padding="15px 25px">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-text align="left" color="{{mutedForeground}}" font-size="12px" font-weight="bold" padding-bottom="10px">
          SHIPPING DETAILS
        </mj-text>
        <mj-table font-size="13px" color="{{foreground}}" cellpadding="5" css-class="stack-table">
          <tr>
            <td style="font-weight: bold; padding: 8px; width: 140px;">Tracking Number</td>
            <td style="padding: 8px;">TRK-9847-2651-AE</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px;">Estimated Delivery</td>
            <td style="padding: 8px; color: {{success}}; font-weight: bold;">Today by 6:00 PM</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px;">Delivery Address</td>
            <td style="padding: 8px;">Sheikh Zayed Road, Tower •••, Apt ••••, Dubai</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Note -->
    <mj-section background-color="{{card}}" padding="10px 25px">
      <mj-column>
        <mj-text align="left" color="{{warning}}" font-size="13px" font-weight="bold" padding="12px 0">
          Someone must be present to receive the delivery.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px 30px">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" font-weight="bold" border-radius="8px" inner-padding="12px 30px" align="left" href="#">
          Track Package
        </mj-button>
      </mj-column>
    </mj-section>
    <!-- /@en -->

    <mj-include path="../../partials/footer.mjml" />

  </mj-body>
</mjml>