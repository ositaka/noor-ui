<!-- @brand: Your Company | شركتك -->
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Tahoma, Arial, sans-serif" />
      <mj-text font-size="14px" color="{{foreground}}" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{background}}" width="600px">

    <mj-include path="../../partials/header.mjml" />

    <!-- @ar -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px" direction="rtl">
      <mj-column>
        <mj-text align="center" padding-bottom="10px">
          <div style="width:48px;height:48px;margin:0 auto;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="{{primary}}" viewBox="0 0 256 256"><path d="M232,98.36C230.73,136.92,198.67,168,160.09,168a71.68,71.68,0,0,1-26.92-5.17h0L120,176H96v24H72v24H40a8,8,0,0,1-8-8V187.31a8,8,0,0,1,2.34-5.65l58.83-58.83h0A71.68,71.68,0,0,1,88,95.91c0-38.58,31.08-70.64,69.64-71.87A72,72,0,0,1,232,98.36Z" opacity="0.2"></path><path d="M216.57,39.43A80,80,0,0,0,83.91,120.78L28.69,176A15.86,15.86,0,0,0,24,187.31V216a16,16,0,0,0,16,16H72a8,8,0,0,0,8-8V208H96a8,8,0,0,0,8-8V184h16a8,8,0,0,0,5.66-2.34l9.56-9.57A79.73,79.73,0,0,0,160,176h.1A80,80,0,0,0,216.57,39.43ZM224,98.1c-1.09,34.09-29.75,61.86-63.89,61.9H160a63.7,63.7,0,0,1-23.65-4.51,8,8,0,0,0-8.84,1.68L116.69,168H96a8,8,0,0,0-8,8v16H72a8,8,0,0,0-8,8v16H40V187.31l58.83-58.82a8,8,0,0,0,1.68-8.84A63.72,63.72,0,0,1,96,95.92c0-34.14,27.81-62.8,61.9-63.89A64,64,0,0,1,224,98.1ZM192,76a12,12,0,1,1-12-12A12,12,0,0,1,192,76Z"></path></svg><!--<![endif]--></div>
        </mj-text>
        <mj-text font-size="22px" font-weight="bold" align="center" color="{{foreground}}" padding-bottom="10px">
          رمز التحقق
        </mj-text>
        <mj-text align="center" color="{{mutedForeground}}" padding-bottom="20px">
          استخدم الرمز التالي لإكمال عملية التحقق. لا تشارك هذا الرمز مع أي شخص.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="0 25px 10px" direction="rtl">
      <mj-column background-color="{{background}}" border-radius="8px" padding="25px">
        <mj-text font-size="36px" font-weight="bold" align="center" color="{{primary}}" letter-spacing="8px">
          4 8 2 7 1 5
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="5px 25px 10px" direction="rtl">
      <mj-column>
        <mj-text align="center" color="{{mutedForeground}}" font-size="13px">
          <span style="display:inline-block;vertical-align:middle;margin-left:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="{{primary}}" viewBox="0 0 256 256"><path d="M216,136a88,88,0,1,1-88-88A88,88,0,0,1,216,136Z" opacity="0.2"></path><path d="M128,40a96,96,0,1,0,96,96A96.11,96.11,0,0,0,128,40Zm0,176a80,80,0,1,1,80-80A80.09,80.09,0,0,1,128,216ZM173.66,90.34a8,8,0,0,1,0,11.32l-40,40a8,8,0,0,1-11.32-11.32l40-40A8,8,0,0,1,173.66,90.34ZM96,16a8,8,0,0,1,8-8h48a8,8,0,0,1,0,16H104A8,8,0,0,1,96,16Z"></path></svg><!--<![endif]--></span> ينتهي صلاحية هذا الرمز خلال 10 دقائق
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="10px 25px 30px" direction="rtl">
      <mj-column>
        <mj-divider border-color="{{border}}" border-width="1px" padding="10px 0 15px 0" />
        <mj-text align="right" color="{{mutedForeground}}" font-size="13px">
          إذا لم تطلب هذا الرمز، يرجى تأمين حسابك فورًا عن طريق تغيير كلمة المرور.
        </mj-text>
        <mj-text align="right" color="{{mutedForeground}}" font-size="12px" padding-top="10px">
          <span style="display:inline-block;vertical-align:middle;margin-left:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="{{primary}}" viewBox="0 0 256 256"><path d="M208,104a79.86,79.86,0,0,1-30.59,62.92A24.29,24.29,0,0,0,168,186v6a8,8,0,0,1-8,8H96a8,8,0,0,1-8-8v-6a24.11,24.11,0,0,0-9.3-19A79.87,79.87,0,0,1,48,104.45C47.76,61.09,82.72,25,126.07,24A80,80,0,0,1,208,104Z" opacity="0.2"></path><path d="M176,232a8,8,0,0,1-8,8H88a8,8,0,0,1,0-16h80A8,8,0,0,1,176,232Zm40-128a87.55,87.55,0,0,1-33.64,69.21A16.24,16.24,0,0,0,176,186v6a16,16,0,0,1-16,16H96a16,16,0,0,1-16-16v-6a16,16,0,0,0-6.23-12.66A87.59,87.59,0,0,1,40,104.49C39.74,56.83,78.26,17.14,125.88,16A88,88,0,0,1,216,104Zm-16,0a72,72,0,0,0-73.74-72c-39,.92-70.47,33.39-70.26,72.39a71.65,71.65,0,0,0,27.64,56.3A32,32,0,0,1,96,186v6h64v-6a32.15,32.15,0,0,1,12.47-25.35A71.65,71.65,0,0,0,200,104Zm-16.11-9.34a57.6,57.6,0,0,0-46.56-46.55,8,8,0,0,0-2.66,15.78c16.57,2.79,30.63,16.85,33.44,33.45A8,8,0,0,0,176,104a9,9,0,0,0,1.35-.11A8,8,0,0,0,183.89,94.66Z"></path></svg><!--<![endif]--></span> <strong>نصيحة أمان:</strong> لن نطلب منك أبدًا مشاركة رمز التحقق عبر الهاتف أو البريد الإلكتروني.
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- /@ar -->

    <!-- @en -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px">
      <mj-column>
        <mj-text align="center" padding-bottom="10px">
          <div style="width:48px;height:48px;margin:0 auto;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="{{primary}}" viewBox="0 0 256 256"><path d="M232,98.36C230.73,136.92,198.67,168,160.09,168a71.68,71.68,0,0,1-26.92-5.17h0L120,176H96v24H72v24H40a8,8,0,0,1-8-8V187.31a8,8,0,0,1,2.34-5.65l58.83-58.83h0A71.68,71.68,0,0,1,88,95.91c0-38.58,31.08-70.64,69.64-71.87A72,72,0,0,1,232,98.36Z" opacity="0.2"></path><path d="M216.57,39.43A80,80,0,0,0,83.91,120.78L28.69,176A15.86,15.86,0,0,0,24,187.31V216a16,16,0,0,0,16,16H72a8,8,0,0,0,8-8V208H96a8,8,0,0,0,8-8V184h16a8,8,0,0,0,5.66-2.34l9.56-9.57A79.73,79.73,0,0,0,160,176h.1A80,80,0,0,0,216.57,39.43ZM224,98.1c-1.09,34.09-29.75,61.86-63.89,61.9H160a63.7,63.7,0,0,1-23.65-4.51,8,8,0,0,0-8.84,1.68L116.69,168H96a8,8,0,0,0-8,8v16H72a8,8,0,0,0-8,8v16H40V187.31l58.83-58.82a8,8,0,0,0,1.68-8.84A63.72,63.72,0,0,1,96,95.92c0-34.14,27.81-62.8,61.9-63.89A64,64,0,0,1,224,98.1ZM192,76a12,12,0,1,1-12-12A12,12,0,0,1,192,76Z"></path></svg><!--<![endif]--></div>
        </mj-text>
        <mj-text font-size="22px" font-weight="bold" align="center" color="{{foreground}}" padding-bottom="10px">
          Verification Code
        </mj-text>
        <mj-text align="center" color="{{mutedForeground}}" padding-bottom="20px">
          Use the following code to complete your verification. Do not share this code with anyone.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="0 25px 10px">
      <mj-column background-color="{{background}}" border-radius="8px" padding="25px">
        <mj-text font-size="36px" font-weight="bold" align="center" color="{{primary}}" letter-spacing="8px">
          4 8 2 7 1 5
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="5px 25px 10px">
      <mj-column>
        <mj-text align="center" color="{{mutedForeground}}" font-size="13px">
          <span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="{{primary}}" viewBox="0 0 256 256"><path d="M216,136a88,88,0,1,1-88-88A88,88,0,0,1,216,136Z" opacity="0.2"></path><path d="M128,40a96,96,0,1,0,96,96A96.11,96.11,0,0,0,128,40Zm0,176a80,80,0,1,1,80-80A80.09,80.09,0,0,1,128,216ZM173.66,90.34a8,8,0,0,1,0,11.32l-40,40a8,8,0,0,1-11.32-11.32l40-40A8,8,0,0,1,173.66,90.34ZM96,16a8,8,0,0,1,8-8h48a8,8,0,0,1,0,16H104A8,8,0,0,1,96,16Z"></path></svg><!--<![endif]--></span> This code expires in 10 minutes
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="10px 25px 30px">
      <mj-column>
        <mj-divider border-color="{{border}}" border-width="1px" padding="10px 0 15px 0" />
        <mj-text align="left" color="{{mutedForeground}}" font-size="13px">
          If you didn't request this code, please secure your account immediately by changing your password.
        </mj-text>
        <mj-text align="left" color="{{mutedForeground}}" font-size="12px" padding-top="10px">
          <span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="{{primary}}" viewBox="0 0 256 256"><path d="M208,104a79.86,79.86,0,0,1-30.59,62.92A24.29,24.29,0,0,0,168,186v6a8,8,0,0,1-8,8H96a8,8,0,0,1-8-8v-6a24.11,24.11,0,0,0-9.3-19A79.87,79.87,0,0,1,48,104.45C47.76,61.09,82.72,25,126.07,24A80,80,0,0,1,208,104Z" opacity="0.2"></path><path d="M176,232a8,8,0,0,1-8,8H88a8,8,0,0,1,0-16h80A8,8,0,0,1,176,232Zm40-128a87.55,87.55,0,0,1-33.64,69.21A16.24,16.24,0,0,0,176,186v6a16,16,0,0,1-16,16H96a16,16,0,0,1-16-16v-6a16,16,0,0,0-6.23-12.66A87.59,87.59,0,0,1,40,104.49C39.74,56.83,78.26,17.14,125.88,16A88,88,0,0,1,216,104Zm-16,0a72,72,0,0,0-73.74-72c-39,.92-70.47,33.39-70.26,72.39a71.65,71.65,0,0,0,27.64,56.3A32,32,0,0,1,96,186v6h64v-6a32.15,32.15,0,0,1,12.47-25.35A71.65,71.65,0,0,0,200,104Zm-16.11-9.34a57.6,57.6,0,0,0-46.56-46.55,8,8,0,0,0-2.66,15.78c16.57,2.79,30.63,16.85,33.44,33.45A8,8,0,0,0,176,104a9,9,0,0,0,1.35-.11A8,8,0,0,0,183.89,94.66Z"></path></svg><!--<![endif]--></span> <strong>Security tip:</strong> We will never ask you to share your verification code over phone or email.
