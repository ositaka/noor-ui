<!-- @brand: Your Company | شركتك -->
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Tahoma, Arial, sans-serif" />
      <mj-text font-size="14px" color="{{foreground}}" line-height="1.6" />
    </mj-attributes>
    <mj-style>
      @media only screen and (max-width: 480px) {
        .stack-table td {
          display: block !important;
          width: 100% !important;
          box-sizing: border-box !important;
        }
        .stack-table tr {
          display: block !important;
          margin-bottom: 12px !important;
        }
        .stack-table-rtl td {
          text-align: right !important;
          direction: rtl !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="{{background}}" width="600px">

    <mj-include path="../../partials/header.mjml" />

    <!-- @ar -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px" direction="rtl">
      <mj-column>
        <mj-text font-size="13px" font-weight="bold" align="right" color="{{primary}}" padding-bottom="8px">
          دعوة خاصة
        </mj-text>
        <mj-text font-size="22px" font-weight="bold" align="right" color="{{foreground}}" padding-bottom="10px">
          قمة التحول الرقمي 2026
        </mj-text>
        <mj-text align="right" color="{{mutedForeground}}" padding-bottom="15px">
          يسعدنا دعوتكم لحضور قمة التحول الرقمي السنوية، حيث يجتمع رواد التقنية والابتكار لمناقشة مستقبل التكنولوجيا في المنطقة.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Event details -->
    <mj-section background-color="{{card}}" padding="0 25px 10px" direction="rtl">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-table font-size="14px" color="{{foreground}}" cellpadding="6" css-class="stack-table stack-table-rtl">
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px; width: 100px; vertical-align: top;">التاريخ <span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M216,48V88H40V48a8,8,0,0,1,8-8H208A8,8,0,0,1,216,48Z" opacity="0.2"></path><path d="M208,32H184V24a8,8,0,0,0-16,0v8H88V24a8,8,0,0,0-16,0v8H48A16,16,0,0,0,32,48V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V48A16,16,0,0,0,208,32ZM72,48v8a8,8,0,0,0,16,0V48h80v8a8,8,0,0,0,16,0V48h24V80H48V48ZM208,208H48V96H208V208Z"></path></svg><!--<![endif]--></span></td>
            <td style="text-align: right; padding: 8px;">&#x200F;15 أبريل 2026</td>
          </tr>
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px; vertical-align: top;">الوقت <span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M224,128a96,96,0,1,1-96-96A96,96,0,0,1,224,128Z" opacity="0.2"></path><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm64-88a8,8,0,0,1-8,8H128a8,8,0,0,1-8-8V72a8,8,0,0,1,16,0v48h48A8,8,0,0,1,192,128Z"></path></svg><!--<![endif]--></span></td>
            <td style="text-align: right; padding: 8px;">9:00 ص - 5:00 م (توقيت الخليج)</td>
          </tr>
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px; vertical-align: top;">المكان <span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M128,24a80,80,0,0,0-80,80c0,72,80,128,80,128s80-56,80-128A80,80,0,0,0,128,24Zm0,112a32,32,0,1,1,32-32A32,32,0,0,1,128,136Z" opacity="0.2"></path><path d="M128,64a40,40,0,1,0,40,40A40,40,0,0,0,128,64Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,128,128Zm0-112a88.1,88.1,0,0,0-88,88c0,31.4,14.51,64.68,42,96.25a254.19,254.19,0,0,0,41.45,38.3,8,8,0,0,0,9.18,0A254.19,254.19,0,0,0,174,200.25c27.45-31.57,42-64.85,42-96.25A88.1,88.1,0,0,0,128,16Zm0,206c-16.53-13-72-60.75-72-118a72,72,0,0,1,144,0C200,161.23,144.53,209,128,222Z"></path></svg><!--<![endif]--></span></td>
            <td style="text-align: right; padding: 8px;">مركز دبي الدولي للمؤتمرات<br/><a href="#" style="color: {{primary}}; text-decoration: none; font-size: 12px;">عرض على الخريطة</a></td>
          </tr>
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px; vertical-align: top;">المتحدث <span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M168,64v64a40,40,0,0,1-40,40h0a40,40,0,0,1-40-40V64a40,40,0,0,1,40-40h0A40,40,0,0,1,168,64Z" opacity="0.2"></path><path d="M128,176a48.05,48.05,0,0,0,48-48V64a48,48,0,0,0-96,0v64A48.05,48.05,0,0,0,128,176ZM96,64a32,32,0,0,1,64,0v64a32,32,0,0,1-64,0Zm40,143.6V240a8,8,0,0,1-16,0V207.6A80.11,80.11,0,0,1,48,128a8,8,0,0,1,16,0,64,64,0,0,0,128,0,8,8,0,0,1,16,0A80.11,80.11,0,0,1,136,207.6Z"></path></svg><!--<![endif]--></span></td>
            <td style="text-align: right; padding: 8px;">د. سارة الحمادي<br/><span style="color: {{mutedForeground}}; font-size: 12px;">مديرة الابتكار التقني</span></td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px 10px" direction="rtl">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="16px" font-weight="bold" border-radius="8px" inner-padding="14px 40px" align="right" href="#">
          تأكيد الحضور
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="0 25px 30px" direction="rtl">
      <mj-column>
        <mj-button background-color="transparent" color="{{primary}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" border="2px solid {{primary}}" border-radius="8px" inner-padding="10px 24px" align="right" href="#">
          إضافة إلى التقويم
        </mj-button>
      </mj-column>
    </mj-section>
    <!-- /@ar -->

    <!-- @en -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px">
      <mj-column>
        <mj-text font-size="13px" font-weight="bold" align="left" color="{{primary}}" padding-bottom="8px">
          YOU'RE INVITED
        </mj-text>
        <mj-text font-size="22px" font-weight="bold" align="left" color="{{foreground}}" padding-bottom="10px">
          Digital Transformation Summit 2026
        </mj-text>
        <mj-text align="left" color="{{mutedForeground}}" padding-bottom="15px">
          We're excited to invite you to our annual Digital Transformation Summit, where technology leaders and innovators gather to discuss the future of tech in the region.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Event details -->
    <mj-section background-color="{{card}}" padding="0 25px 10px">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-table font-size="14px" color="{{foreground}}" cellpadding="6" css-class="stack-table">
          <tr>
            <td style="font-weight: bold; padding: 8px; width: 100px; vertical-align: top;"><span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M216,48V88H40V48a8,8,0,0,1,8-8H208A8,8,0,0,1,216,48Z" opacity="0.2"></path><path d="M208,32H184V24a8,8,0,0,0-16,0v8H88V24a8,8,0,0,0-16,0v8H48A16,16,0,0,0,32,48V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V48A16,16,0,0,0,208,32ZM72,48v8a8,8,0,0,0,16,0V48h80v8a8,8,0,0,0,16,0V48h24V80H48V48ZM208,208H48V96H208V208Z"></path></svg><!--<![endif]--></span> Date</td>
            <td style="padding: 8px;">April 15, 2026</td>
          </tr>
          <tr>
            <td style="font-weight: bold; padding: 8px; vertical-align: top;"><span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M224,128a96,96,0,1,1-96-96A96,96,0,0,1,224,128Z" opacity="0.2"></path><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm64-88a8,8,0,0,1-8,8H128a8,8,0,0,1-8-8V72a8,8,0,0,1,16,0v48h48A8,8,0,0,1,192,128Z"></path></svg><!--<![endif]--></span> Time</td>
            <td style="padding: 8px;">9:00 AM - 5:00 PM (GST)</td>
          </tr>
          <tr>
            <td style="font-weight: bold; padding: 8px; vertical-align: top;"><span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M128,24a80,80,0,0,0-80,80c0,72,80,128,80,128s80-56,80-128A80,80,0,0,0,128,24Zm0,112a32,32,0,1,1,32-32A32,32,0,0,1,128,136Z" opacity="0.2"></path><path d="M128,64a40,40,0,1,0,40,40A40,40,0,0,0,128,64Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,128,128Zm0-112a88.1,88.1,0,0,0-88,88c0,31.4,14.51,64.68,42,96.25a254.19,254.19,0,0,0,41.45,38.3,8,8,0,0,0,9.18,0A254.19,254.19,0,0,0,174,200.25c27.45-31.57,42-64.85,42-96.25A88.1,88.1,0,0,0,128,16Zm0,206c-16.53-13-72-60.75-72-118a72,72,0,0,1,144,0C200,161.23,144.53,209,128,222Z"></path></svg><!--<![endif]--></span> Venue</td>
            <td style="padding: 8px;">Dubai International Convention Centre<br/><a href="#" style="color: {{primary}}; text-decoration: none; font-size: 12px;">View on Map</a></td>
          </tr>
          <tr>
            <td style="font-weight: bold; padding: 8px; vertical-align: top;"><span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M168,64v64a40,40,0,0,1-40,40h0a40,40,0,0,1-40-40V64a40,40,0,0,1,40-40h0A40,40,0,0,1,168,64Z" opacity="0.2"></path><path d="M128,176a48.05,48.05,0,0,0,48-48V64a48,48,0,0,0-96,0v64A48.05,48.05,0,0,0,128,176ZM96,64a32,32,0,0,1,64,0v64a32,32,0,0,1-64,0Zm40,143.6V240a8,8,0,0,1-16,0V207.6A80.11,80.11,0,0,1,48,128a8,8,0,0,1,16,0,64,64,0,0,0,128,0,8,8,0,0,1,16,0A80.11,80.11,0,0,1,136,207.6Z"></path></svg><!--<![endif]--></span> Speaker</td>
            <td style="padding: 8px;">Dr. Sara Al Hamadi<br/><span style="color: {{mutedForeground}}; font-size: 12px;">Director of Tech Innovation</span></td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px 10px">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="16px" font-weight="bold" border-radius="8px" inner-padding="14px 40px" align="left" href="#">
          RSVP Now
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="0 25px 30px">
      <mj-column>
        <mj-button background-color="transparent" color="{{primary}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" border="2px solid {{primary}}" border-radius="8px" inner-padding="10px 24px" align="left" href="#">
          Add to Calendar
        </mj-button>
      </mj-column>
    </mj-section>
    <!-- /@en -->

    <mj-include path="../../partials/footer.mjml" />

  </mj-body>
</mjml>
