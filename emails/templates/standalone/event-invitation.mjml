<!-- @brand: Your Company | شركتك -->
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Tahoma, Arial, sans-serif" />
      <mj-text font-size="14px" color="{{foreground}}" line-height="1.6" />
    </mj-attributes>
    <mj-style>
      @media only screen and (max-width: 480px) {
        .stack-table td {
          display: block !important;
          width: 100% !important;
          box-sizing: border-box !important;
        }
        .stack-table tr {
          display: block !important;
          margin-bottom: 12px !important;
        }
        .stack-table-rtl td {
          text-align: right !important;
          direction: rtl !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="{{background}}" width="600px">

    <mj-include path="../../partials/header.mjml" />

    <!-- @ar -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px" direction="rtl">
      <mj-column>
        <mj-text font-size="13px" font-weight="bold" align="right" color="{{primary}}" padding-bottom="8px">
          دعوة خاصة
        </mj-text>
        <mj-text font-size="22px" font-weight="bold" align="right" color="{{foreground}}" padding-bottom="10px">
          قمة التحول الرقمي 2026
        </mj-text>
        <mj-text align="right" color="{{mutedForeground}}" padding-bottom="15px">
          يسعدنا دعوتكم لحضور قمة التحول الرقمي السنوية، حيث يجتمع رواد التقنية والابتكار لمناقشة مستقبل التكنولوجيا في المنطقة.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Event details -->
    <mj-section background-color="{{card}}" padding="0 25px 10px" direction="rtl">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-table font-size="14px" color="{{foreground}}" cellpadding="6" css-class="stack-table stack-table-rtl">
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px; width: 100px; vertical-align: top;">📅 التاريخ</td>
            <td style="text-align: right; padding: 8px;">&#x200F;15 أبريل 2026</td>
          </tr>
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px; vertical-align: top;">🕐 الوقت</td>
            <td style="text-align: right; padding: 8px;">9:00 ص - 5:00 م (توقيت الخليج)</td>
          </tr>
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px; vertical-align: top;">📍 المكان</td>
            <td style="text-align: right; padding: 8px;">مركز دبي الدولي للمؤتمرات<br/><a href="#" style="color: {{primary}}; text-decoration: none; font-size: 12px;">عرض على الخريطة</a></td>
          </tr>
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px; vertical-align: top;">🎤 المتحدث</td>
            <td style="text-align: right; padding: 8px;">د. سارة الحمادي<br/><span style="color: {{mutedForeground}}; font-size: 12px;">مديرة الابتكار التقني</span></td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px 10px" direction="rtl">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="16px" font-weight="bold" border-radius="8px" inner-padding="14px 40px" align="right" href="#">
          تأكيد الحضور
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="0 25px 30px" direction="rtl">
      <mj-column>
        <mj-button background-color="transparent" color="{{primary}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" border="2px solid {{primary}}" border-radius="8px" inner-padding="10px 24px" align="right" href="#">
          إضافة إلى التقويم
        </mj-button>
      </mj-column>
    </mj-section>
    <!-- /@ar -->

    <!-- @en -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px">
      <mj-column>
        <mj-text font-size="13px" font-weight="bold" align="left" color="{{primary}}" padding-bottom="8px">
          YOU'RE INVITED
        </mj-text>
        <mj-text font-size="22px" font-weight="bold" align="left" color="{{foreground}}" padding-bottom="10px">
          Digital Transformation Summit 2026
        </mj-text>
        <mj-text align="left" color="{{mutedForeground}}" padding-bottom="15px">
          We're excited to invite you to our annual Digital Transformation Summit, where technology leaders and innovators gather to discuss the future of tech in the region.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Event details -->
    <mj-section background-color="{{card}}" padding="0 25px 10px">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-table font-size="14px" color="{{foreground}}" cellpadding="6" css-class="stack-table">
          <tr>
            <td style="font-weight: bold; padding: 8px; width: 100px; vertical-align: top;">📅 Date</td>
            <td style="padding: 8px;">April 15, 2026</td>
          </tr>
          <tr>
            <td style="font-weight: bold; padding: 8px; vertical-align: top;">🕐 Time</td>
            <td style="padding: 8px;">9:00 AM - 5:00 PM (GST)</td>
          </tr>
          <tr>
            <td style="font-weight: bold; padding: 8px; vertical-align: top;">📍 Venue</td>
            <td style="padding: 8px;">Dubai International Convention Centre<br/><a href="#" style="color: {{primary}}; text-decoration: none; font-size: 12px;">View on Map</a></td>
          </tr>
          <tr>
            <td style="font-weight: bold; padding: 8px; vertical-align: top;">🎤 Speaker</td>
            <td style="padding: 8px;">Dr. Sara Al Hamadi<br/><span style="color: {{mutedForeground}}; font-size: 12px;">Director of Tech Innovation</span></td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px 10px">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="16px" font-weight="bold" border-radius="8px" inner-padding="14px 40px" align="left" href="#">
          RSVP Now
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="0 25px 30px">
      <mj-column>
        <mj-button background-color="transparent" color="{{primary}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" border="2px solid {{primary}}" border-radius="8px" inner-padding="10px 24px" align="left" href="#">
          Add to Calendar
        </mj-button>
      </mj-column>
    </mj-section>
    <!-- /@en -->

    <mj-include path="../../partials/footer.mjml" />

  </mj-body>
</mjml>
