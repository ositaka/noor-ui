<!-- @brand: Your Company | شركتك -->
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Tahoma, Arial, sans-serif" />
      <mj-text font-size="14px" color="{{foreground}}" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{background}}" width="600px">

    <mj-include path="../../partials/header.mjml" />

    <!-- @ar -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px" direction="rtl">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" align="right" color="{{foreground}}" padding-bottom="5px">
          فاتورة #INV-2026-00847
        </mj-text>
        <mj-text align="right" color="{{mutedForeground}}" font-size="13px">
          تاريخ الإصدار: 18 مارس 2026
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px" direction="rtl">
      <mj-column background-color="{{background}}" border-radius="8px" padding="15px">
        <mj-text align="right" color="{{mutedForeground}}" font-size="12px" font-weight="bold" padding-bottom="5px">
          معلومات الفاتورة
        </mj-text>
        <mj-text align="right" color="{{foreground}}" font-size="13px" line-height="1.8">
          أحمد خالد المنصوري<br/>
          شارع الشيخ زايد، برج المارينا<br/>
          دبي، الإمارات العربية المتحدة
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Line items table -->
    <mj-section background-color="{{card}}" padding="10px 25px 0" direction="rtl">
      <mj-column>
        <mj-table font-size="13px" color="{{foreground}}" cellpadding="8" css-class="items-table">
          <tr style="border-bottom: 2px solid {{border}}; font-weight: bold; text-align: right;">
            <td style="padding: 10px 8px;">الصنف</td>
            <td style="padding: 10px 8px; text-align: center;">الكمية</td>
            <td style="padding: 10px 8px; text-align: left;">السعر</td>
            <td style="padding: 10px 8px; text-align: left;">المجموع</td>
          </tr>
          <tr style="border-bottom: 1px solid {{border}}; text-align: right;">
            <td style="padding: 10px 8px;">خطة الاشتراك السنوية</td>
            <td style="padding: 10px 8px; text-align: center;">1</td>
            <td style="padding: 10px 8px; text-align: left;">1,200 د.إ</td>
            <td style="padding: 10px 8px; text-align: left;">1,200 د.إ</td>
          </tr>
          <tr style="border-bottom: 1px solid {{border}}; text-align: right;">
            <td style="padding: 10px 8px;">مساحة تخزين إضافية (100 جيجا)</td>
            <td style="padding: 10px 8px; text-align: center;">2</td>
            <td style="padding: 10px 8px; text-align: left;">150 د.إ</td>
            <td style="padding: 10px 8px; text-align: left;">300 د.إ</td>
          </tr>
          <tr style="border-bottom: 1px solid {{border}}; text-align: right;">
            <td style="padding: 10px 8px;">خدمة الدعم المتميز</td>
            <td style="padding: 10px 8px; text-align: center;">1</td>
            <td style="padding: 10px 8px; text-align: left;">500 د.إ</td>
            <td style="padding: 10px 8px; text-align: left;">500 د.إ</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Totals -->
    <mj-section background-color="{{card}}" padding="5px 25px" direction="rtl">
      <mj-column width="60%">
        <mj-text font-size="1px" color="{{card}}">&nbsp;</mj-text>
      </mj-column>
      <mj-column width="40%">
        <mj-table font-size="13px" color="{{foreground}}" cellpadding="6">
          <tr style="text-align: left;">
            <td style="text-align: right; padding: 6px;">المجموع الفرعي</td>
            <td style="padding: 6px;">2,000 د.إ</td>
          </tr>
          <tr style="text-align: left;">
            <td style="text-align: right; padding: 6px;">ضريبة القيمة المضافة (5%)</td>
            <td style="padding: 6px;">100 د.إ</td>
          </tr>
          <tr style="text-align: left; font-weight: bold; border-top: 2px solid {{border}};">
            <td style="text-align: right; padding: 8px 6px;">الإجمالي</td>
            <td style="padding: 8px 6px; color: {{primary}};">2,100 د.إ</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Payment method -->
    <mj-section background-color="{{card}}" padding="10px 25px" direction="rtl">
      <mj-column background-color="{{background}}" border-radius="8px" padding="12px 15px">
        <mj-text align="right" color="{{mutedForeground}}" font-size="12px">
          <strong>طريقة الدفع:</strong> بطاقة فيزا تنتهي بـ •••• 4821
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px 30px" direction="rtl">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" font-weight="bold" border-radius="8px" inner-padding="12px 30px" align="right" href="#">
          تنزيل PDF
        </mj-button>
      </mj-column>
    </mj-section>
    <!-- /@ar -->

    <!-- @en -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" align="left" color="{{foreground}}" padding-bottom="5px">
          Invoice #INV-2026-00847
        </mj-text>
        <mj-text align="left" color="{{mutedForeground}}" font-size="13px">
          Issue Date: March 18, 2026
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px">
      <mj-column background-color="{{background}}" border-radius="8px" padding="15px">
        <mj-text align="left" color="{{mutedForeground}}" font-size="12px" font-weight="bold" padding-bottom="5px">
          BILL TO
        </mj-text>
        <mj-text align="left" color="{{foreground}}" font-size="13px" line-height="1.8">
          Ahmed Khaled Al Mansouri<br/>
          Sheikh Zayed Road, Marina Tower<br/>
          Dubai, United Arab Emirates
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Line items table -->
    <mj-section background-color="{{card}}" padding="10px 25px 0">
      <mj-column>
        <mj-table font-size="13px" color="{{foreground}}" cellpadding="8">
          <tr style="border-bottom: 2px solid {{border}}; font-weight: bold;">
            <td style="padding: 10px 8px;">Item</td>
            <td style="padding: 10px 8px; text-align: center;">Qty</td>
            <td style="padding: 10px 8px; text-align: right;">Price</td>
            <td style="padding: 10px 8px; text-align: right;">Total</td>
          </tr>
          <tr style="border-bottom: 1px solid {{border}};">
            <td style="padding: 10px 8px;">Annual Subscription Plan</td>
            <td style="padding: 10px 8px; text-align: center;">1</td>
            <td style="padding: 10px 8px; text-align: right;">AED 1,200</td>
            <td style="padding: 10px 8px; text-align: right;">AED 1,200</td>
          </tr>
          <tr style="border-bottom: 1px solid {{border}};">
            <td style="padding: 10px 8px;">Extra Storage (100GB)</td>
            <td style="padding: 10px 8px; text-align: center;">2</td>
            <td style="padding: 10px 8px; text-align: right;">AED 150</td>
            <td style="padding: 10px 8px; text-align: right;">AED 300</td>
          </tr>
          <tr style="border-bottom: 1px solid {{border}};">
            <td style="padding: 10px 8px;">Premium Support Service</td>
            <td style="padding: 10px 8px; text-align: center;">1</td>
            <td style="padding: 10px 8px; text-align: right;">AED 500</td>
            <td style="padding: 10px 8px; text-align: right;">AED 500</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Totals -->
    <mj-section background-color="{{card}}" padding="5px 25px">
      <mj-column width="60%">
        <mj-text font-size="1px" color="{{card}}">&nbsp;</mj-text>
      </mj-column>
      <mj-column width="40%">
        <mj-table font-size="13px" color="{{foreground}}" cellpadding="6">
          <tr>
            <td style="padding: 6px;">Subtotal</td>
            <td style="text-align: right; padding: 6px;">AED 2,000</td>
          </tr>
          <tr>
            <td style="padding: 6px;">VAT (5%)</td>
            <td style="text-align: right; padding: 6px;">AED 100</td>
          </tr>
          <tr style="font-weight: bold; border-top: 2px solid {{border}};">
            <td style="padding: 8px 6px;">Total</td>
            <td style="text-align: right; padding: 8px 6px; color: {{primary}};">AED 2,100</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Payment method -->
    <mj-section background-color="{{card}}" padding="10px 25px">
      <mj-column background-color="{{background}}" border-radius="8px" padding="12px 15px">
        <mj-text align="left" color="{{mutedForeground}}" font-size="12px">
          <strong>Payment method:</strong> Visa ending in •••• 4821
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px 30px">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" font-weight="bold" border-radius="8px" inner-padding="12px 30px" align="left" href="#">
          Download PDF
        </mj-button>
      </mj-column>
    </mj-section>
    <!-- /@en -->

    <mj-include path="../../partials/footer.mjml" />

  </mj-body>
</mjml>
