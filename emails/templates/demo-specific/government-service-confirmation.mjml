<!-- @brand: Noor Gov Portal | بوابة النور الحكومية -->
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Tahoma, Arial, sans-serif" />
      <mj-text font-size="14px" color="{{foreground}}" line-height="1.6" />
    </mj-attributes>
    <mj-style>
      @media only screen and (max-width: 480px) {
        .stack-table td {
          display: block !important;
          width: 100% !important;
          box-sizing: border-box !important;
        }
        .stack-table tr {
          display: block !important;
          margin-bottom: 12px !important;
        }
        .stack-table-rtl td {
          text-align: right !important;
          direction: rtl !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="{{background}}" width="600px">

    <mj-include path="../../partials/header.mjml" />

    <!-- @ar -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px" direction="rtl">
      <mj-column>
        <mj-text align="center" padding-bottom="15px">
          <!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="{{primary}}" viewBox="0 0 256 256"><path d="M136,32V216H40V85.35a8,8,0,0,1,3.56-6.66l80-53.33A8,8,0,0,1,136,32Z" opacity="0.2"></path><path d="M240,208H224V96a16,16,0,0,0-16-16H144V32a16,16,0,0,0-24.88-13.32L39.12,72A16,16,0,0,0,32,85.34V208H16a8,8,0,0,0,0,16H240a8,8,0,0,0,0-16ZM208,96V208H144V96ZM48,85.34,128,32V208H48ZM112,112v16a8,8,0,0,1-16,0V112a8,8,0,1,1,16,0Zm-32,0v16a8,8,0,0,1-16,0V112a8,8,0,1,1,16,0Zm0,56v16a8,8,0,0,1-16,0V168a8,8,0,0,1,16,0Zm32,0v16a8,8,0,0,1-16,0V168a8,8,0,0,1,16,0Z"></path></svg><!--<![endif]-->
        </mj-text>
        <mj-text font-size="22px" font-weight="bold" align="right" color="{{foreground}}" padding-bottom="5px">
          تم تقديم الطلب
        </mj-text>
        <mj-text align="right" padding-bottom="5px">
          <span style="background-color: {{success}}; color: #FFFFFF; padding: 4px 14px; border-radius: 12px; font-size: 12px; font-weight: bold;">
            تم الإرسال بنجاح ✓
          </span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Request details -->
    <mj-section background-color="{{card}}" padding="15px 25px" direction="rtl">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-text align="right" color="{{mutedForeground}}" font-size="12px" font-weight="bold" padding-bottom="10px">
          تفاصيل الطلب
        </mj-text>
        <mj-table font-size="13px" color="{{foreground}}" cellpadding="5" css-class="stack-table stack-table-rtl">
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px; width: 130px;">رقم الطلب</td>
            <td style="text-align: right; padding: 8px;">&#x200F;GOV-2026-48291</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px;">نوع الخدمة</td>
            <td style="text-align: right; padding: 8px;">تجديد الرخصة التجارية</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px;">تاريخ التقديم</td>
            <td style="text-align: right; padding: 8px;">&#x200F;19 مارس 2026</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px;">مدة المعالجة</td>
            <td style="text-align: right; padding: 8px;">&#x200F;3-5 أيام عمل</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Required documents -->
    <mj-section background-color="{{card}}" padding="10px 25px" direction="rtl">
      <mj-column>
        <mj-text font-size="15px" font-weight="bold" align="right" color="{{foreground}}" padding-bottom="10px">
          المستندات المطلوبة
        </mj-text>
        <mj-text align="right" color="{{foreground}}" font-size="13px" line-height="2">
          <span style="display:inline-block;vertical-align:middle;margin-left:6px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="{{success}}" viewBox="0 0 256 256"><path d="M224,128a96,96,0,1,1-96-96A96,96,0,0,1,224,128Z" opacity="0.2"></path><path d="M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z"></path></svg><!--<![endif]--></span> نسخة من الرخصة التجارية الحالية<br/>
          <span style="display:inline-block;vertical-align:middle;margin-left:6px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="{{success}}" viewBox="0 0 256 256"><path d="M224,128a96,96,0,1,1-96-96A96,96,0,0,1,224,128Z" opacity="0.2"></path><path d="M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z"></path></svg><!--<![endif]--></span> عقد إيجار المكتب / المحل<br/>
          <span style="display:inline-block;vertical-align:middle;margin-left:6px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="{{success}}" viewBox="0 0 256 256"><path d="M224,128a96,96,0,1,1-96-96A96,96,0,0,1,224,128Z" opacity="0.2"></path><path d="M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z"></path></svg><!--<![endif]--></span> نسخة من الهوية الإماراتية<br/>
          <span style="display:inline-block;vertical-align:middle;margin-left:6px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="{{success}}" viewBox="0 0 256 256"><path d="M224,128a96,96,0,1,1-96-96A96,96,0,0,1,224,128Z" opacity="0.2"></path><path d="M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z"></path></svg><!--<![endif]--></span> إيصال دفع الرسوم
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Note -->
    <mj-section background-color="{{card}}" padding="10px 25px" direction="rtl">
      <mj-column>
        <mj-text align="right" color="{{mutedForeground}}" font-size="12px" font-style="italic">
          ستصلك رسالة نصية عند الانتهاء من معالجة طلبك.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px 30px" direction="rtl">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" font-weight="bold" border-radius="8px" inner-padding="12px 30px" align="right" href="#">
          تتبع الطلب
        </mj-button>
      </mj-column>
    </mj-section>
    <!-- /@ar -->

    <!-- @en -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px">
      <mj-column>
        <mj-text align="center" padding-bottom="15px">
          <!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="{{primary}}" viewBox="0 0 256 256"><path d="M136,32V216H40V85.35a8,8,0,0,1,3.56-6.66l80-53.33A8,8,0,0,1,136,32Z" opacity="0.2"></path><path d="M240,208H224V96a16,16,0,0,0-16-16H144V32a16,16,0,0,0-24.88-13.32L39.12,72A16,16,0,0,0,32,85.34V208H16a8,8,0,0,0,0,16H240a8,8,0,0,0,0-16ZM208,96V208H144V96ZM48,85.34,128,32V208H48ZM112,112v16a8,8,0,0,1-16,0V112a8,8,0,1,1,16,0Zm-32,0v16a8,8,0,0,1-16,0V112a8,8,0,1,1,16,0Zm0,56v16a8,8,0,0,1-16,0V168a8,8,0,0,1,16,0Zm32,0v16a8,8,0,0,1-16,0V168a8,8,0,0,1,16,0Z"></path></svg><!--<![endif]-->
        </mj-text>
        <mj-text font-size="22px" font-weight="bold" align="left" color="{{foreground}}" padding-bottom="5px">
          Service Request Submitted
        </mj-text>
        <mj-text align="left" padding-bottom="5px">
          <span style="background-color: {{success}}; color: #FFFFFF; padding: 4px 14px; border-radius: 12px; font-size: 12px; font-weight: bold;">
            Submitted Successfully ✓
          </span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Request details -->
    <mj-section background-color="{{card}}" padding="15px 25px">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-text align="left" color="{{mutedForeground}}" font-size="12px" font-weight="bold" padding-bottom="10px">
          REQUEST DETAILS
        </mj-text>
        <mj-table font-size="13px" color="{{foreground}}" cellpadding="5" css-class="stack-table">
          <tr>
            <td style="font-weight: bold; padding: 8px; width: 140px;">Request Number</td>
            <td style="padding: 8px;">GOV-2026-48291</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px;">Service Type</td>
            <td style="padding: 8px;">Business License Renewal</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px;">Submission Date</td>
            <td style="padding: 8px;">March 19, 2026</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px;">Processing Time</td>
            <td style="padding: 8px;">3-5 business days</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Required documents -->
    <mj-section background-color="{{card}}" padding="10px 25px">
      <mj-column>
        <mj-text font-size="15px" font-weight="bold" align="left" color="{{foreground}}" padding-bottom="10px">
          Required Documents
        </mj-text>
        <mj-text align="left" color="{{foreground}}" font-size="13px" line-height="2">
          <span style="display:inline-block;vertical-align:middle;margin-right:6px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="{{success}}" viewBox="0 0 256 256"><path d="M224,128a96,96,0,1,1-96-96A96,96,0,0,1,224,128Z" opacity="0.2"></path><path d="M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z"></path></svg><!--<![endif]--></span> Copy of current trade license<br/>
          <span style="display:inline-block;vertical-align:middle;margin-right:6px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="{{success}}" viewBox="0 0 256 256"><path d="M224,128a96,96,0,1,1-96-96A96,96,0,0,1,224,128Z" opacity="0.2"></path><path d="M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z"></path></svg><!--<![endif]--></span> Office / shop tenancy contract<br/>
          <span style="display:inline-block;vertical-align:middle;margin-right:6px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="{{success}}" viewBox="0 0 256 256"><path d="M224,128a96,96,0,1,1-96-96A96,96,0,0,1,224,128Z" opacity="0.2"></path><path d="M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z"></path></svg><!--<![endif]--></span> Copy of Emirates ID<br/>
          <span style="display:inline-block;vertical-align:middle;margin-right:6px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="{{success}}" viewBox="0 0 256 256"><path d="M224,128a96,96,0,1,1-96-96A96,96,0,0,1,224,128Z" opacity="0.2"></path><path d="M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z"></path></svg><!--<![endif]--></span> Fee payment receipt
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Note -->
    <mj-section background-color="{{card}}" padding="10px 25px">
      <mj-column>
        <mj-text align="left" color="{{mutedForeground}}" font-size="12px" font-style="italic">
          You will receive an SMS when your request is processed.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px 30px">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" font-weight="bold" border-radius="8px" inner-padding="12px 30px" align="left" href="#">
          Track Request
        </mj-button>
      </mj-column>
    </mj-section>
    <!-- /@en -->

    <mj-include path="../../partials/footer.mjml" />

  </mj-body>
</mjml>