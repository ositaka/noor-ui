<!-- @brand: Al Noor Medical Center | مركز النور الطبي -->
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Tahoma, Arial, sans-serif" />
      <mj-text font-size="14px" color="{{foreground}}" line-height="1.6" />
    </mj-attributes>
    <mj-style>
      @media only screen and (max-width: 480px) {
        .stack-table td {
          display: block !important;
          width: 100% !important;
          box-sizing: border-box !important;
        }
        .stack-table tr {
          display: block !important;
          margin-bottom: 12px !important;
        }
        .stack-table-rtl td {
          text-align: right !important;
          direction: rtl !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="{{background}}" width="600px">

    <mj-include path="../../partials/header.mjml" />

    <!-- @ar -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px" direction="rtl">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" align="right" color="{{foreground}}" padding-bottom="5px">
          تذكير بالموعد
        </mj-text>
        <mj-text align="right" color="{{primary}}" font-size="15px" font-weight="bold">
          موعدك غدًا
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Appointment details -->
    <mj-section background-color="{{card}}" padding="15px 25px" direction="rtl">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-table font-size="14px" color="{{foreground}}" cellpadding="5" css-class="stack-table stack-table-rtl">
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px; width: 100px; vertical-align: top;">التاريخ <span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M216,48V88H40V48a8,8,0,0,1,8-8H208A8,8,0,0,1,216,48Z" opacity="0.2"></path><path d="M208,32H184V24a8,8,0,0,0-16,0v8H88V24a8,8,0,0,0-16,0v8H48A16,16,0,0,0,32,48V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V48A16,16,0,0,0,208,32ZM72,48v8a8,8,0,0,0,16,0V48h80v8a8,8,0,0,0,16,0V48h24V80H48V48ZM208,208H48V96H208V208Z"></path></svg><!--<![endif]--></span></td>
            <td style="text-align: right; padding: 8px;">&#x200F;19 مارس 2026 (الخميس)</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px; vertical-align: top;">الوقت <span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M224,128a96,96,0,1,1-96-96A96,96,0,0,1,224,128Z" opacity="0.2"></path><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm64-88a8,8,0,0,1-8,8H128a8,8,0,0,1-8-8V72a8,8,0,0,1,16,0v48h48A8,8,0,0,1,192,128Z"></path></svg><!--<![endif]--></span></td>
            <td style="text-align: right; padding: 8px;">10:30 ص</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px; vertical-align: top;">الطبيب <span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M240,160a32,32,0,1,1-32-32A32,32,0,0,1,240,160Z" opacity="0.2"></path><path d="M220,160a12,12,0,1,1-12-12A12,12,0,0,1,220,160Zm-4.55,39.29A48.08,48.08,0,0,1,168,240H144a48.05,48.05,0,0,1-48-48V151.49A64,64,0,0,1,40,88V40a8,8,0,0,1,8-8H72a8,8,0,0,1,0,16H56V88a48,48,0,0,0,48.64,48c26.11-.34,47.36-22.25,47.36-48.83V48H136a8,8,0,0,1,0-16h24a8,8,0,0,1,8,8V87.17c0,32.84-24.53,60.29-56,64.31V192a32,32,0,0,0,32,32h24a32.06,32.06,0,0,0,31.22-25,40,40,0,1,1,16.23.27ZM232,160a24,24,0,1,0-24,24A24,24,0,0,0,232,160Z"></path></svg><!--<![endif]--></span></td>
            <td style="text-align: right; padding: 8px;">د. أحمد الراشدي<br/><span style="color: {{mutedForeground}}; font-size: 12px;">أخصائي الطب الباطني</span></td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px; vertical-align: top;">الموقع <span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M128,24a80,80,0,0,0-80,80c0,72,80,128,80,128s80-56,80-128A80,80,0,0,0,128,24Zm0,112a32,32,0,1,1,32-32A32,32,0,0,1,128,136Z" opacity="0.2"></path><path d="M128,64a40,40,0,1,0,40,40A40,40,0,0,0,128,64Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,128,128Zm0-112a88.1,88.1,0,0,0-88,88c0,31.4,14.51,64.68,42,96.25a254.19,254.19,0,0,0,41.45,38.3,8,8,0,0,0,9.18,0A254.19,254.19,0,0,0,174,200.25c27.45-31.57,42-64.85,42-96.25A88.1,88.1,0,0,0,128,16Zm0,206c-16.53-13-72-60.75-72-118a72,72,0,0,1,144,0C200,161.23,144.53,209,128,222Z"></path></svg><!--<![endif]--></span></td>
            <td style="text-align: right; padding: 8px;">مركز النور الطبي<br/><span style="color: {{mutedForeground}}; font-size: 12px;">الطابق 3، عيادة 312</span></td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Preparation -->
    <mj-section background-color="{{card}}" padding="10px 25px" direction="rtl">
      <mj-column>
        <mj-text font-size="15px" font-weight="bold" align="right" color="{{foreground}}" padding-bottom="8px">
          تعليمات التحضير
        </mj-text>
        <mj-text align="right" color="{{mutedForeground}}" font-size="13px" line-height="1.8">
          • الصيام لمدة 8 ساعات قبل الموعد (ماء فقط)<br/>
          • إحضار بطاقة الهوية الإماراتية أو جواز السفر<br/>
          • إحضار بطاقة التأمين الصحي<br/>
          • إحضار نتائج الفحوصات السابقة (إن وجدت)<br/>
          • الحضور قبل الموعد بـ 15 دقيقة
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px" direction="rtl">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" font-weight="bold" border-radius="8px" inner-padding="12px 30px" align="right" href="#">
          تأكيد الموعد
        </mj-button>
      </mj-column>
      <mj-column>
        <mj-button background-color="transparent" color="{{primary}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" border="2px solid {{primary}}" border-radius="8px" inner-padding="10px 24px" align="right" href="#">
          إعادة الجدولة
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="5px 25px 30px" direction="rtl">
      <mj-column>
        <mj-text align="center" color="{{mutedForeground}}" font-size="12px">
          <a href="#" style="color: {{destructive}}; text-decoration: underline;">إلغاء الموعد</a>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- /@ar -->

    <!-- @en -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" align="left" color="{{foreground}}" padding-bottom="5px">
          Appointment Reminder
        </mj-text>
        <mj-text align="left" color="{{primary}}" font-size="15px" font-weight="bold">
          Your appointment is tomorrow
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Appointment details -->
    <mj-section background-color="{{card}}" padding="15px 25px">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-table font-size="14px" color="{{foreground}}" cellpadding="5" css-class="stack-table">
          <tr>
            <td style="font-weight: bold; padding: 8px; width: 100px; vertical-align: top;"><span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M216,48V88H40V48a8,8,0,0,1,8-8H208A8,8,0,0,1,216,48Z" opacity="0.2"></path><path d="M208,32H184V24a8,8,0,0,0-16,0v8H88V24a8,8,0,0,0-16,0v8H48A16,16,0,0,0,32,48V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V48A16,16,0,0,0,208,32ZM72,48v8a8,8,0,0,0,16,0V48h80v8a8,8,0,0,0,16,0V48h24V80H48V48ZM208,208H48V96H208V208Z"></path></svg><!--<![endif]--></span> Date</td>
            <td style="padding: 8px;">March 19, 2026 (Thursday)</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px; vertical-align: top;"><span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M224,128a96,96,0,1,1-96-96A96,96,0,0,1,224,128Z" opacity="0.2"></path><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm64-88a8,8,0,0,1-8,8H128a8,8,0,0,1-8-8V72a8,8,0,0,1,16,0v48h48A8,8,0,0,1,192,128Z"></path></svg><!--<![endif]--></span> Time</td>
            <td style="padding: 8px;">10:30 AM</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px; vertical-align: top;"><span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M240,160a32,32,0,1,1-32-32A32,32,0,0,1,240,160Z" opacity="0.2"></path><path d="M220,160a12,12,0,1,1-12-12A12,12,0,0,1,220,160Zm-4.55,39.29A48.08,48.08,0,0,1,168,240H144a48.05,48.05,0,0,1-48-48V151.49A64,64,0,0,1,40,88V40a8,8,0,0,1,8-8H72a8,8,0,0,1,0,16H56V88a48,48,0,0,0,48.64,48c26.11-.34,47.36-22.25,47.36-48.83V48H136a8,8,0,0,1,0-16h24a8,8,0,0,1,8,8V87.17c0,32.84-24.53,60.29-56,64.31V192a32,32,0,0,0,32,32h24a32.06,32.06,0,0,0,31.22-25,40,40,0,1,1,16.23.27ZM232,160a24,24,0,1,0-24,24A24,24,0,0,0,232,160Z"></path></svg><!--<![endif]--></span> Doctor</td>
            <td style="padding: 8px;">Dr. Ahmed Al Rashedi<br/><span style="color: {{mutedForeground}}; font-size: 12px;">Internal Medicine Specialist</span></td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px; vertical-align: top;"><span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M128,24a80,80,0,0,0-80,80c0,72,80,128,80,128s80-56,80-128A80,80,0,0,0,128,24Zm0,112a32,32,0,1,1,32-32A32,32,0,0,1,128,136Z" opacity="0.2"></path><path d="M128,64a40,40,0,1,0,40,40A40,40,0,0,0,128,64Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,128,128Zm0-112a88.1,88.1,0,0,0-88,88c0,31.4,14.51,64.68,42,96.25a254.19,254.19,0,0,0,41.45,38.3,8,8,0,0,0,9.18,0A254.19,254.19,0,0,0,174,200.25c27.45-31.57,42-64.85,42-96.25A88.1,88.1,0,0,0,128,16Zm0,206c-16.53-13-72-60.75-72-118a72,72,0,0,1,144,0C200,161.23,144.53,209,128,222Z"></path></svg><!--<![endif]--></span> Location</td>
            <td style="padding: 8px;">Al Noor Medical Center<br/><span style="color: {{mutedForeground}}; font-size: 12px;">Floor 3, Clinic 312</span></td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Preparation -->
    <mj-section background-color="{{card}}" padding="10px 25px">
      <mj-column>
        <mj-text font-size="15px" font-weight="bold" align="left" color="{{foreground}}" padding-bottom="8px">
          Preparation Instructions
        </mj-text>
        <mj-text align="left" color="{{mutedForeground}}" font-size="13px" line-height="1.8">
          • Fast for 8 hours before the appointment (water only)<br/>
          • Bring your Emirates ID or passport<br/>
          • Bring your health insurance card<br/>
          • Bring previous test results (if any)<br/>
          • Arrive 15 minutes before your appointment
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" font-weight="bold" border-radius="8px" inner-padding="12px 30px" align="left" href="#">
          Confirm Appointment
        </mj-button>
      </mj-column>
      <mj-column>
        <mj-button background-color="transparent" color="{{primary}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" border="2px solid {{primary}}" border-radius="8px" inner-padding="10px 24px" align="left" href="#">
          Reschedule
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="5px 25px 30px">
      <mj-column>
        <mj-text align="center" color="{{mutedForeground}}" font-size="12px">
          <a href="#" style="color: {{destructive}}; text-decoration: underline;">Cancel Appointment</a>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- /@en -->

    <mj-include path="../../partials/footer.mjml" />

  </mj-body>
</mjml>
