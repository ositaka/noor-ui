<!-- @brand: Al Noor International School | مدرسة النور الدولية -->
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Tahoma, Arial, sans-serif" />
      <mj-text font-size="14px" color="{{foreground}}" line-height="1.6" />
    </mj-attributes>
    <mj-style>
      @media only screen and (max-width: 480px) {
        .stack-table td {
          display: block !important;
          width: 100% !important;
          box-sizing: border-box !important;
        }
        .stack-table tr {
          display: block !important;
          margin-bottom: 12px !important;
        }
        .stack-table-rtl td {
          text-align: right !important;
          direction: rtl !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="{{background}}" width="600px">

    <mj-include path="../../partials/header.mjml" />

    <!-- @ar -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px" direction="rtl">
      <mj-column>
        <mj-text font-size="13px" font-weight="bold" align="right" color="{{primary}}" padding-bottom="5px">
          واجب جديد
        </mj-text>
        <mj-text font-size="22px" font-weight="bold" align="right" color="{{foreground}}" padding-bottom="10px">
          بحث عن الطاقة المتجددة
        </mj-text>
        <mj-text align="right" color="{{mutedForeground}}" font-size="13px">
          مادة العلوم · الصف التاسع
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Assignment details -->
    <mj-section background-color="{{card}}" padding="15px 25px" direction="rtl">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-table font-size="14px" color="{{foreground}}" cellpadding="5" css-class="stack-table stack-table-rtl">
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px; width: 120px;">تاريخ التسليم <span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M216,48V88H40V48a8,8,0,0,1,8-8H208A8,8,0,0,1,216,48Z" opacity="0.2"></path><path d="M208,32H184V24a8,8,0,0,0-16,0v8H88V24a8,8,0,0,0-16,0v8H48A16,16,0,0,0,32,48V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V48A16,16,0,0,0,208,32ZM72,48v8a8,8,0,0,0,16,0V48h80v8a8,8,0,0,0,16,0V48h24V80H48V48ZM208,208H48V96H208V208Z"></path></svg><!--<![endif]--></span></td>
            <td style="text-align: right; padding: 8px;">&#x200F;25 مارس 2026</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px;">الوقت المتبقي <span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M216,136a88,88,0,1,1-88-88A88,88,0,0,1,216,136Z" opacity="0.2"></path><path d="M128,40a96,96,0,1,0,96,96A96.11,96.11,0,0,0,128,40Zm0,176a80,80,0,1,1,80-80A80.09,80.09,0,0,1,128,216ZM173.66,90.34a8,8,0,0,1,0,11.32l-40,40a8,8,0,0,1-11.32-11.32l40-40A8,8,0,0,1,173.66,90.34ZM96,16a8,8,0,0,1,8-8h48a8,8,0,0,1,0,16H104A8,8,0,0,1,96,16Z"></path></svg><!--<![endif]--></span></td>
            <td style="text-align: right; padding: 8px; color: {{warning}}; font-weight: bold;">&#x200F;7 أيام</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px;">المعلمة <span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M216,113.07v53.22a8,8,0,0,1-2,5.31c-11.3,12.59-38.9,36.4-86,36.4s-74.68-23.81-86-36.4a8,8,0,0,1-2-5.31V113.07L128,160Z" opacity="0.2"></path><path d="M251.76,88.94l-120-64a8,8,0,0,0-7.52,0l-120,64a8,8,0,0,0,0,14.12L32,117.87v48.42a15.91,15.91,0,0,0,4.06,10.65C49.16,191.53,78.51,216,128,216a130,130,0,0,0,48-8.76V240a8,8,0,0,0,16,0V199.51a115.63,115.63,0,0,0,27.94-22.57A15.91,15.91,0,0,0,224,166.29V117.87l27.76-14.81a8,8,0,0,0,0-14.12ZM128,200c-43.27,0-68.72-21.14-80-33.71V126.4l76.24,40.66a8,8,0,0,0,7.52,0L176,143.47v46.34C163.4,195.69,147.52,200,128,200Zm80-33.75a97.83,97.83,0,0,1-16,14.25V134.93l16-8.53ZM188,118.94l-.22-.13-56-29.87a8,8,0,0,0-7.52,14.12L171,128l-43,22.93L25,96,128,41.07,231,96Z"></path></svg><!--<![endif]--></span></td>
            <td style="text-align: right; padding: 8px;">أ. فاطمة الكعبي</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Description -->
    <mj-section background-color="{{card}}" padding="10px 25px" direction="rtl">
      <mj-column>
        <mj-text font-size="15px" font-weight="bold" align="right" color="{{foreground}}" padding-bottom="8px">
          الوصف
        </mj-text>
        <mj-text align="right" color="{{mutedForeground}}" font-size="13px" line-height="1.8">
          اكتب بحثًا من 500-700 كلمة عن مصادر الطاقة المتجددة وتأثيرها على البيئة في دول الخليج. يجب أن يتضمن البحث:<br/><br/>
          1. مقدمة عن الطاقة المتجددة<br/>
          2. أنواع الطاقة المتجددة المستخدمة في المنطقة<br/>
          3. مشروع مصدر في أبوظبي كدراسة حالة<br/>
          4. خاتمة ورأيك الشخصي
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px 20px" direction="rtl">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" font-weight="bold" border-radius="8px" inner-padding="12px 30px" align="right" href="#">
          عرض الواجب
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="0 25px 30px" direction="rtl">
      <mj-column background-color="{{background}}" border-radius="8px" padding="12px 15px">
        <mj-text align="right" color="{{mutedForeground}}" font-size="12px">
          <span style="display:inline-block;vertical-align:middle;margin-left:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="{{primary}}" viewBox="0 0 256 256"><path d="M208,48V216a8,8,0,0,1-8,8H56a8,8,0,0,1-8-8V48a8,8,0,0,1,8-8H96a39.83,39.83,0,0,0-8,24v8h80V64a39.83,39.83,0,0,0-8-24h40A8,8,0,0,1,208,48Z" opacity="0.2"></path><path d="M168,152a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,152Zm-8-40H96a8,8,0,0,0,0,16h64a8,8,0,0,0,0-16Zm56-64V216a16,16,0,0,1-16,16H56a16,16,0,0,1-16-16V48A16,16,0,0,1,56,32H92.26a47.92,47.92,0,0,1,71.48,0H200A16,16,0,0,1,216,48ZM96,64h64a32,32,0,0,0-64,0ZM200,48H173.25A47.93,47.93,0,0,1,176,64v8a8,8,0,0,1-8,8H88a8,8,0,0,1-8-8V64a47.93,47.93,0,0,1,2.75-16H56V216H200Z"></path></svg><!--<![endif]--></span> تم إرسال نسخة من هذا الإشعار إلى ولي الأمر المسجل.
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- /@ar -->

    <!-- @en -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px">
      <mj-column>
        <mj-text font-size="13px" font-weight="bold" align="left" color="{{primary}}" padding-bottom="5px">
          NEW ASSIGNMENT
        </mj-text>
        <mj-text font-size="22px" font-weight="bold" align="left" color="{{foreground}}" padding-bottom="10px">
          Renewable Energy Research Paper
        </mj-text>
        <mj-text align="left" color="{{mutedForeground}}" font-size="13px">
          Science · Grade 9
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Assignment details -->
    <mj-section background-color="{{card}}" padding="15px 25px">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-table font-size="14px" color="{{foreground}}" cellpadding="5" css-class="stack-table">
          <tr>
            <td style="font-weight: bold; padding: 8px; width: 120px;"><span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M216,48V88H40V48a8,8,0,0,1,8-8H208A8,8,0,0,1,216,48Z" opacity="0.2"></path><path d="M208,32H184V24a8,8,0,0,0-16,0v8H88V24a8,8,0,0,0-16,0v8H48A16,16,0,0,0,32,48V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V48A16,16,0,0,0,208,32ZM72,48v8a8,8,0,0,0,16,0V48h80v8a8,8,0,0,0,16,0V48h24V80H48V48ZM208,208H48V96H208V208Z"></path></svg><!--<![endif]--></span> Due Date</td>
            <td style="padding: 8px;">March 25, 2026</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px;"><span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M216,136a88,88,0,1,1-88-88A88,88,0,0,1,216,136Z" opacity="0.2"></path><path d="M128,40a96,96,0,1,0,96,96A96.11,96.11,0,0,0,128,40Zm0,176a80,80,0,1,1,80-80A80.09,80.09,0,0,1,128,216ZM173.66,90.34a8,8,0,0,1,0,11.32l-40,40a8,8,0,0,1-11.32-11.32l40-40A8,8,0,0,1,173.66,90.34ZM96,16a8,8,0,0,1,8-8h48a8,8,0,0,1,0,16H104A8,8,0,0,1,96,16Z"></path></svg><!--<![endif]--></span> Time Left</td>
            <td style="padding: 8px; color: {{warning}}; font-weight: bold;">7 days</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px;"><span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="{{primary}}" viewBox="0 0 256 256"><path d="M216,113.07v53.22a8,8,0,0,1-2,5.31c-11.3,12.59-38.9,36.4-86,36.4s-74.68-23.81-86-36.4a8,8,0,0,1-2-5.31V113.07L128,160Z" opacity="0.2"></path><path d="M251.76,88.94l-120-64a8,8,0,0,0-7.52,0l-120,64a8,8,0,0,0,0,14.12L32,117.87v48.42a15.91,15.91,0,0,0,4.06,10.65C49.16,191.53,78.51,216,128,216a130,130,0,0,0,48-8.76V240a8,8,0,0,0,16,0V199.51a115.63,115.63,0,0,0,27.94-22.57A15.91,15.91,0,0,0,224,166.29V117.87l27.76-14.81a8,8,0,0,0,0-14.12ZM128,200c-43.27,0-68.72-21.14-80-33.71V126.4l76.24,40.66a8,8,0,0,0,7.52,0L176,143.47v46.34C163.4,195.69,147.52,200,128,200Zm80-33.75a97.83,97.83,0,0,1-16,14.25V134.93l16-8.53ZM188,118.94l-.22-.13-56-29.87a8,8,0,0,0-7.52,14.12L171,128l-43,22.93L25,96,128,41.07,231,96Z"></path></svg><!--<![endif]--></span> Teacher</td>
            <td style="padding: 8px;">Ms. Fatima Al Kaabi</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Description -->
    <mj-section background-color="{{card}}" padding="10px 25px">
      <mj-column>
        <mj-text font-size="15px" font-weight="bold" align="left" color="{{foreground}}" padding-bottom="8px">
          Description
        </mj-text>
        <mj-text align="left" color="{{mutedForeground}}" font-size="13px" line-height="1.8">
          Write a 500-700 word research paper about renewable energy sources and their environmental impact in the Gulf region. Your paper should include:<br/><br/>
          1. Introduction to renewable energy<br/>
          2. Types of renewable energy used in the region<br/>
          3. Masdar City in Abu Dhabi as a case study<br/>
          4. Conclusion and your personal opinion
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px 20px">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" font-weight="bold" border-radius="8px" inner-padding="12px 30px" align="left" href="#">
          View Assignment
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="0 25px 30px">
      <mj-column background-color="{{background}}" border-radius="8px" padding="12px 15px">
        <mj-text align="left" color="{{mutedForeground}}" font-size="12px">
          <span style="display:inline-block;vertical-align:middle;margin-right:4px;"><!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="{{primary}}" viewBox="0 0 256 256"><path d="M208,48V216a8,8,0,0,1-8,8H56a8,8,0,0,1-8-8V48a8,8,0,0,1,8-8H96a39.83,39.83,0,0,0-8,24v8h80V64a39.83,39.83,0,0,0-8-24h40A8,8,0,0,1,208,48Z" opacity="0.2"></path><path d="M168,152a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,152Zm-8-40H96a8,8,0,0,0,0,16h64a8,8,0,0,0,0-16Zm56-64V216a16,16,0,0,1-16,16H56a16,16,0,0,1-16-16V48A16,16,0,0,1,56,32H92.26a47.92,47.92,0,0,1,71.48,0H200A16,16,0,0,1,216,48ZM96,64h64a32,32,0,0,0-64,0ZM200,48H173.25A47.93,47.93,0,0,1,176,64v8a8,8,0,0,1-8,8H88a8,8,0,0,1-8-8V64a47.93,47.93,0,0,1,2.75-16H56V216H200Z"></path></svg><!--<![endif]--></span> A copy of this notification has been sent to the registered parent/guardian.
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- /@en -->

    <mj-include path="../../partials/footer.mjml" />

  </mj-body>
</mjml>
