<!-- @brand: Souq Al Noor | سوق النور -->
<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Tahoma, Arial, sans-serif" />
      <mj-text font-size="14px" color="{{foreground}}" line-height="1.6" />
    </mj-attributes>
    <mj-style>
      @media only screen and (max-width: 480px) {
        .stack-table td {
          display: block !important;
          width: 100% !important;
          box-sizing: border-box !important;
        }
        .stack-table tr {
          display: block !important;
          margin-bottom: 12px !important;
        }
        .stack-table-rtl td {
          text-align: right !important;
          direction: rtl !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="{{background}}" width="600px">

    <mj-include path="../../partials/header.mjml" />

    <!-- @ar -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px" direction="rtl">
      <mj-column>
        <mj-text align="center" padding-bottom="15px">
          <!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="{{primary}}" viewBox="0 0 256 256"><path d="M224,56V200a8,8,0,0,1-8,8H40a8,8,0,0,1-8-8V56a8,8,0,0,1,8-8H216A8,8,0,0,1,224,56Z" opacity="0.2"></path><path d="M216,40H40A16,16,0,0,0,24,56V200a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A16,16,0,0,0,216,40Zm0,160H40V56H216V200ZM176,88a48,48,0,0,1-96,0,8,8,0,0,1,16,0,32,32,0,0,0,64,0,8,8,0,0,1,16,0Z"></path></svg><!--<![endif]-->
        </mj-text>
        <mj-text font-size="22px" font-weight="bold" align="right" color="{{foreground}}" padding-bottom="5px">
          طلب جديد
        </mj-text>
        <mj-text align="right" color="{{mutedForeground}}" font-size="13px">
          رقم الطلب: #ORD-2026-58234
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Order details -->
    <mj-section background-color="{{card}}" padding="15px 25px" direction="rtl">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-text align="right" color="{{mutedForeground}}" font-size="12px" font-weight="bold" padding-bottom="10px">
          تفاصيل الطلب
        </mj-text>
        <mj-table font-size="13px" color="{{foreground}}" cellpadding="5" css-class="stack-table stack-table-rtl">
          <tr>
            <td style="text-align: right; font-weight: bold; padding: 8px; width: 120px;">اسم المشتري</td>
            <td style="text-align: right; padding: 8px;">محمد ع. •••</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px;">المنتج</td>
            <td style="text-align: right; padding: 8px;">سماعات لاسلكية بلوتوث برو</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px;">الكمية</td>
            <td style="text-align: right; padding: 8px;">&#x200F;2</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px;">السعر</td>
            <td style="text-align: right; padding: 8px;">&#x200F;698 د.إ</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="text-align: right; font-weight: bold; padding: 8px;">آخر موعد للشحن</td>
            <td style="text-align: right; padding: 8px;">&#x200F;21 مارس 2026</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Note -->
    <mj-section background-color="{{card}}" padding="10px 25px" direction="rtl">
      <mj-column>
        <mj-text align="right" color="{{warning}}" font-size="13px" font-weight="bold" padding="12px 0">
          يرجى شحن الطلب خلال 48 ساعة للحفاظ على تقييم البائع.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px 30px" direction="rtl">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" font-weight="bold" border-radius="8px" inner-padding="12px 30px" align="right" href="#">
          معالجة الطلب
        </mj-button>
      </mj-column>
    </mj-section>
    <!-- /@ar -->

    <!-- @en -->
    <mj-section background-color="{{card}}" padding="30px 25px 10px">
      <mj-column>
        <mj-text align="center" padding-bottom="15px">
          <!--[if !mso]><!--><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="{{primary}}" viewBox="0 0 256 256"><path d="M224,56V200a8,8,0,0,1-8,8H40a8,8,0,0,1-8-8V56a8,8,0,0,1,8-8H216A8,8,0,0,1,224,56Z" opacity="0.2"></path><path d="M216,40H40A16,16,0,0,0,24,56V200a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A16,16,0,0,0,216,40Zm0,160H40V56H216V200ZM176,88a48,48,0,0,1-96,0,8,8,0,0,1,16,0,32,32,0,0,0,64,0,8,8,0,0,1,16,0Z"></path></svg><!--<![endif]-->
        </mj-text>
        <mj-text font-size="22px" font-weight="bold" align="left" color="{{foreground}}" padding-bottom="5px">
          New Order Received
        </mj-text>
        <mj-text align="left" color="{{mutedForeground}}" font-size="13px">
          Order Number: #ORD-2026-58234
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Order details -->
    <mj-section background-color="{{card}}" padding="15px 25px">
      <mj-column background-color="{{background}}" border-radius="8px" padding="20px">
        <mj-text align="left" color="{{mutedForeground}}" font-size="12px" font-weight="bold" padding-bottom="10px">
          ORDER DETAILS
        </mj-text>
        <mj-table font-size="13px" color="{{foreground}}" cellpadding="5" css-class="stack-table">
          <tr>
            <td style="font-weight: bold; padding: 8px; width: 130px;">Buyer</td>
            <td style="padding: 8px;">Mohammed A. •••</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px;">Item</td>
            <td style="padding: 8px;">Wireless Bluetooth Headphones Pro</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px;">Quantity</td>
            <td style="padding: 8px;">2</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px;">Price</td>
            <td style="padding: 8px;">AED 698</td>
          </tr>
          <tr style="border-top: 1px solid {{border}};">
            <td style="font-weight: bold; padding: 8px;">Ship By</td>
            <td style="padding: 8px;">March 21, 2026</td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Note -->
    <mj-section background-color="{{card}}" padding="10px 25px">
      <mj-column>
        <mj-text align="left" color="{{warning}}" font-size="13px" font-weight="bold" padding="12px 0">
          Ship within 48 hours to maintain your seller rating.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="{{card}}" padding="15px 25px 30px">
      <mj-column>
        <mj-button background-color="{{primary}}" color="{{primaryForeground}}" font-family="Tahoma, Arial, sans-serif" font-size="14px" font-weight="bold" border-radius="8px" inner-padding="12px 30px" align="left" href="#">
          Process Order
        </mj-button>
      </mj-column>
    </mj-section>
    <!-- /@en -->

    <mj-include path="../../partials/footer.mjml" />

  </mj-body>
</mjml>